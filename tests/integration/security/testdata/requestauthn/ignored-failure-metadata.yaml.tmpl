apiVersion: security.istio.io/v1
kind: RequestAuthentication
metadata:
  name: {{ .To.ServiceName }}
spec:
  selector:
    matchLabels:
      app: {{ .To.ServiceName }}
  jwtRules:
  - issuer: "test-issuer-1@istio.io"
    jwksUri: "{{ .JWTServer.JwksURI }}"
    presence: IGNORED
    failedStatusInMetadata: true
    fromHeaders:
    - name: "authorization"
      prefix: "Bearer "
---
# Surface the JWT verification failure metadata in the target's access logs
# via the jwt-failure-log provider configured in main_test.go.
apiVersion: telemetry.istio.io/v1
kind: Telemetry
metadata:
  name: {{ .To.ServiceName }}
spec:
  selector:
    matchLabels:
      app: {{ .To.ServiceName }}
  accessLogging:
  - providers:
    - name: jwt-failure-log
